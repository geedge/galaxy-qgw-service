{
  "type": "record",
  "name": "dos_protection_rule_metric",
  "namespace": "druid",
  "doc": {
    "partition_key": "__time",
    "functions": {
      "$ref": "public_schema_info.json#/functions"
    },
    "schema_query": {
      "time": [
        "__time"
      ],
      "dimensions": [
        "rule_uuid",
        "device_group",
        "data_center"
      ],
      "metrics": [
        "sessions",
        "bytes",
        "pkts"
      ],
      "filters": [
        "rule_uuid",
        "device_group",
        "data_center"
      ],
      "references": {
        "$ref": "public_schema_info.json#/schema_query/references"
      }
    },
    "measurements": {
     "retentions": "1s:1800d",
      "ingestion_delay": 15,
      "aggregated_metric_unit": {
        "SUM": {
          "sessions": "sessions",
          "bytes": "bytes",
          "pkts": "packets"
        },
        "RATE": {
          "sessions": "sps",
          "bytes": "Bps",
          "pkts": "pps"
        },
        "BITRATE": {
          "bytes": "bps"
        }
      }
    }
  },
  "fields": [
    {
      "name": "__time",
      "label": "Time",
      "type": {
        "type": "string",
        "logicalType": "timestamp"
      },
      "doc": {
        "constraints": {
          "type": "timestamp"
        },
        "visibility": "enabled"
      }
    },
    {
      "name": "insert_time",
      "label": "Insert Time",
      "type": "long",
      "doc": {
        "visibility": "enabled"
      }
    },
    {
      "name": "data_center",
      "label": "Data Center",
      "type": "string",
      "doc": {
        "constraints": {
          "operator_functions": "=,in"
        },
        "data": {
          "$ref": "device_tag.json#",
          "key": "$[?(@.tagType=='data_center')].subTags.[?(@.tagType=='data_center')]['tagValue']",
          "value": "$[?(@.tagType=='data_center')].subTags.[?(@.tagType=='data_center')]['tagName']"
        },
        "visibility": "enabled"
      }
    },
    {
      "name": "device_group",
      "label": "Device Group",
      "type": "string",
      "doc": {
        "constraints": {
          "operator_functions": "=,in"
        },
        "data": {
          "$ref": "device_tag.json#",
          "key": "$[?(@.tagType=='device_group')].subTags.[?(@.tagType=='device_group')]['tagValue']",
          "value": "$[?(@.tagType=='device_group')].subTags.[?(@.tagType=='device_group')]['tagName']"
        },
        "visibility": "enabled"
      }
    },
    {
      "name": "device_id",
      "label": "Device ID",
      "doc": {
        "visibility": "enabled"
      },
      "type": "string"
    },
    {
      "name": "vsys_id",
      "label": "Vsys ID",
      "doc": {
        "visibility": "enabled"
      },
      "type": "long",
      "default": 1
    },
    {
      "name": "rule_uuid",
      "label": "Rule",
      "doc": {
        "constraints": {
          "operator_functions": "=,in"
        },
        "visibility": "enabled"
      },
      "type": "string"
    },
    {
      "name": "name",
      "label": "Name",
      "doc": {
        "constraints": {
          "operator_functions": "=,in"
        },
        "visibility": "enabled"
      },
      "type": "string"
    },
    {
      "name": "client_ip",
      "label": "Client IP",
      "doc": {
        "constraints": {
          "type": "ip"
        },
        "visibility": "enabled"
      },
      "type": "string"
    },
    {
      "name": "client_country",
      "label": "Client Country",
      "doc": {
        "constraints": {
          "type": "country"
        },
        "visibility": "enabled"
      },
      "type": "string"
    },
    {
      "name": "server_ip",
      "label": "Server IP",
      "doc": {
        "constraints": {
          "type": "ip"
        },
        "visibility": "enabled"
      },
      "type": "string"
    },
    {
      "name": "server_country",
      "label": "Server Country",
      "doc": {
        "constraints": {
          "type": "country"
        },
        "visibility": "enabled"
      },
      "type": "string"
    },
    {
      "name": "sessions",
      "label": "Sessions",
      "doc": {
        "constraints": {
          "metric_type": "count",
          "aggregation_functions": "SUM, RATE, BITRATE"
        },
        "visibility": "enabled"
      },
      "type": "long"
    },
    {
      "name": "bytes",
      "label": "Bytes",
      "doc": {
        "constraints": {
          "metric_type": "count",
          "aggregation_functions": "SUM, RATE, BITRATE"
        },
        "visibility": "enabled"
      },
      "type": "long"
    },
    {
      "name": "pkts",
      "label": "Packets",
      "doc": {
        "constraints": {
          "metric_type": "count",
          "aggregation_functions": "SUM, RATE"
        },
        "visibility": "enabled"
      },
      "type": "long"
    }
  ]
}