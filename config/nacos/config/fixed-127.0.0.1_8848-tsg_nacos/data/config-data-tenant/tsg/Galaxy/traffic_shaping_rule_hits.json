{
  "type": "record",
  "name": "traffic_shaping_rule_hits",
  "namespace": "druid",
  "doc": {
    "partition_key": "__time",
    "functions": {
      "$ref": "public_schema_info.json#/functions"
    },
    "schema_query": {
      "time": [
        "__time"
      ],
      "dimensions": [
        "rule_id",
        "profile_id",
        "device_group",
        "data_center"
      ],
      "metrics": [
        "in_bytes",
        "out_bytes",
        "in_pkts",
        "out_pkts",
        "in_drop_pkt",
        "out_drop_pkts"
      ],
      "filters": [
        "rule_id",
        "profile_id",
        "priority",
        "device_group",
        "data_center"
      ],
      "references": {
        "$ref": "public_schema_info.json#/schema_query/references"
      }
    },
    "measurements": {
      "granularity": 1,
      "ingestion_delay": 5,
      "aggregated_metric_unit": {
        "SUM": {
          "in_bytes": "bytes",
          "out_bytes": "bytes",
          "in_pkts": "packets",
          "out_pkts": "packets",
          "in_drop_pkt": "packets",
          "out_drop_pkts": "packets"
        },
        "RATE": {
          "in_bytes": "Bps",
          "out_bytes": "Bps",
          "in_pkts": "pps",
          "out_pkts": "pps",
          "in_drop_pkt": "pps",
          "out_drop_pkts": "pps"
        },
        "BITRATE": {
          "in_bytes": "bps",
          "out_bytes": "bps"
        }
      }
    }
  },
  "fields": [
    {
      "name": "__time",
      "label": "Time",
      "type": {
        "type": "string",
        "logicalType": "timestamp"
      },
      "doc": {
        "constraints": {
          "type": "timestamp"
        },
        "visibility": "enabled"
      }
    },
    {
      "name": "vsys_id",
      "label": "Vsys ID",
      "doc": {
        "visibility": "enabled"
      },
      "type": "int",
      "default": 1
    },
    {
      "name": "device_id",
      "label": "Device ID",
      "doc": {
        "visibility": "enabled"
      },
      "type": "string"
    },
    {
      "name": "device_group",
      "label": "Device Group",
      "type": "string",
      "doc": {
        "constraints": {
          "operator_functions": "=,in"
        },
        "data": {
          "$ref": "device_tag.json#",
          "key": "$[?(@.tagType=='device_group')].subTags.[?(@.tagType=='device_group')]['tagValue']",
          "value": "$[?(@.tagType=='device_group')].subTags.[?(@.tagType=='device_group')]['tagName']"
        },
        "visibility": "enabled"
      }
    },
    {
      "name": "data_center",
      "label": "Data Center",
      "type": "string",
      "doc": {
        "constraints": {
          "operator_functions": "=,in"
        },
        "data": {
          "$ref": "device_tag.json#",
          "key": "$[?(@.tagType=='data_center')].subTags.[?(@.tagType=='data_center')]['tagValue']",
          "value": "$[?(@.tagType=='data_center')].subTags.[?(@.tagType=='data_center')]['tagName']"
        },
        "visibility": "enabled"
      }
    },
    {
      "name": "rule_id",
      "label": "Rule",
      "type": "int",
      "doc": {
        "constraints": {
          "operator_functions": "=,in"
        },
        "visibility": "enabled"
      }
    },
    {
      "name": "profile_id",
      "label": "Profile ID",
      "type": "int",
      "doc": {
        "visibility": "enabled"
      }
    },
    {
      "name": "priority",
      "label": "Priority",
      "type": "int",
      "doc": {
        "visibility": "enabled"
      }
    },
    {
      "name": "in_bytes",
      "label": "Incoming Bytes",
      "type": "int",
      "doc": {
        "constraints": {
          "metric_type": "counter",
          "aggregation_functions": "SUM, RATE, BITRATE"
        },
        "visibility": "enabled"
      }
    },
    {
      "name": "in_pkts",
      "label": "Incoming Packets",
      "type": "int",
      "doc": {
        "constraints": {
          "metric_type": "counter",
          "aggregation_functions": "SUM, RATE"
        },
        "visibility": "enabled"
      }
    },
    {
      "name": "out_bytes",
      "label": "Outgoing Bytes",
      "type": "int",
      "doc": {
        "constraints": {
          "metric_type": "counter",
          "aggregation_functions": "SUM, RATE, BITRATE"
        },
        "visibility": "enabled"
      }
    },
    {
      "name": "out_pkts",
      "label": "Outgoing Packets",
      "type": "int",
      "doc": {
        "constraints": {
          "metric_type": "counter",
          "aggregation_functions": "SUM, RATE"
        },
        "visibility": "enabled"
      }
    },
    {
      "name": "in_drop_pkts",
      "label": "Incoming Drop Packets",
      "type": "int",
      "doc": {
        "constraints": {
          "metric_type": "counter",
          "aggregation_functions": "SUM, RATE"
        },
        "visibility": "enabled"
      }
    },
    {
      "name": "out_drop_pkts",
      "label": "Outgoing Drop Packets",
      "type": "int",
      "doc": {
        "constraints": {
          "metric_type": "counter",
          "aggregation_functions": "SUM, RATE"
        },
        "visibility": "enabled"
      }
    },
    {
      "name": "in_max_latency_us",
      "label": "Incoming Max Latency (us)",
      "type": "int",
      "doc": {
        "constraints": {
          "metric_type": "gauge"
        },
        "visibility": "enabled"
      }
    },
    {
      "name": "out_max_latency_us",
      "label": "Outgoing Max Latency (us)",
      "type": "int",
      "doc": {
        "constraints": {
          "metric_type": "gauge"
        },
        "visibility": "enabled"
      }
    },
    {
      "name": "in_queue_len",
      "label": "Incoming Queue Length",
      "type": "int",
      "doc": {
        "constraints": {
          "metric_type": "gauge"
        },
        "visibility": "enabled"
      }
    },
    {
      "name": "out_queue_len",
      "label": "Outgoing Queue Length",
      "type": "int",
      "doc": {
        "constraints": {
          "metric_type": "gauge"
        },
        "visibility": "enabled"
      }
    }
  ]
}