      "name": "recv_time",
      "label": "Receive Time",
      "doc": {
        "constraints": {
          "type": "unix_timestamp"
        },
        "visibility": "enabled",
        "ttl": null
      },
      "type": {
        "type": "long",
        "logicalType": "unix_timestamp"
      }
    },
    {
      "name": "start_time",
      "label": "Start Time",
      "doc": {
        "constraints": {
          "type": "unix_timestamp"
        },
        "visibility": "enabled",
        "ttl": null
      },
      "type": {
        "type": "long",
        "logicalType": "unix_timestamp"
      }
    },
    {
      "name": "end_time",
      "label": "End Time",
      "doc": {
        "constraints": {
          "type": "unix_timestamp"
        },
        "visibility": "enabled",
        "ttl": null
      },
      "type": {
        "type": "long",
        "logicalType": "unix_timestamp"
      }
    },
    {
