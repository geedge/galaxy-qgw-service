{
  "type": "record",
  "name": "dos_event",
  "namespace": "tsg_galaxy_v3",
  "doc": {
    "primary_key": "log_id",
    "partition_key": "recv_time",
    "ttl": null,
    "default_ttl": 2592000,
    "index_key": [
      "vsys_id",
      "destination_ip",
      "recv_time",
      "log_id"
    ],
    "functions": {
      "$ref": "public_schema_info.json#/functions"
    },
    "schema_query": {
      "time": [
        "recv_time",
        "start_time",
        "end_time"
      ],
      "references": {
        "$ref": "public_schema_info.json#/schema_query/references"
      }
    },
    "default_columns": [
      "log_id",
      "attack_type",
      "source_ip_list",
      "destination_ip",
      "severity",
      "start_time",
      "end_time",
      "packet_rate",
      "bit_rate",
      "session_rate"
    ],
    "internal_columns": [
      "recv_time",
      "log_id"
    ],
    "measurements": {
      "field_discovery_metric": {
        "sessions": [
          {
            "fn": "count",
            "column": "log_id",
            "value": "sessions",
            "label": "Sessions",
            "unit": "sessions"
          }
        ]
      }
    }
  },
  "fields": [
