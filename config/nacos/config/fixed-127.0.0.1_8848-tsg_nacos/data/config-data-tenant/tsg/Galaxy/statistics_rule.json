        "sessions",
        "new_unestablished_sessions",
        "syn_pkts",
        "session_identifier_sketch",
        "client_ip_sketch",
        "server_ip_sketch",
        "in_latency_ms_sketch",
        "out_latency_ms_sketch",
        "latency_ms_sketch"
      ],
      "filters": [
        "vsys_id",
        "device_id",
        "device_group",
        "data_center",
        "rule_id",
        "template_id",
        "chart_id",
        "version",
        "client_ip_object",
        "server_ip_object",
        "fqdn_category",
        "client_ip",
        "server_ip",
        "server_fqdn",
        "server_domain",
        "application",
        "in_bytes",
        "out_bytes",
        "bytes",
        "new_c2s_flows",
        "new_s2c_flows",
