{
  "type": "record",
  "name": "statistics_rule",
  "namespace": "druid",
  "doc": {
    "partition_key": "__time",
    "functions": {
      "$ref": "public_schema_info.json#/functions"
    },
    "schema_query": {
      "time": [
        "__time"
      ],
      "dimensions": [
        "device_group",
        "client_ip",
        "server_ip",
        "client_asn",
        "server_asn",
        "client_country",
        "server_country",
        "server_fqdn",
        "server_domain",
        "application",
        "fqdn_category",
        "client_ip_object",
        "server_ip_object",
        "c2s_ttl",
        "s2c_ttl",
        "c2s_link_id",
        "s2c_link_id",
        "client_port",
        "server_port"
      ],
      "metrics": [
        "in_bytes",
        "out_bytes",
        "bytes",
        "in_pkts",
        "out_pkts",
        "pkts",
        "new_c2s_flows",
        "new_s2c_flows",
        "new_in_sessions",
        "new_out_sessions",
        "sessions",
        "new_unestablished_sessions",
        "syn_pkts",
        "c2s_ip_fragments",
        "s2c_ip_fragments",
        "ip_fragments",
        "session_identifier_sketch",
        "client_ip_sketch",
        "server_ip_sketch",
        "in_latency_ms_sketch",
        "out_latency_ms_sketch",
        "latency_ms_sketch",
        "in_pkt_length_sketch",
        "out_pkt_length_sketch",
        "pkt_length_sketch"
      ],
      "filters": [
        "device_id",
        "device_group",
        "data_center",
        "rule_id",
        "template_id",
        "chart_id",
        "version"
      ],
      "references": {
        "$ref": "public_schema_info.json#/schema_query/references"
      }
    },
    "measurements": {
      "ingestion_period": "PT1S",
      "compaction_period": "PT1M",
      "skip_compaction_offset_from_latest": "P7D",
      "ingestion_delay": 5,
      "aggregated_metric_unit": {
        "SUM": {
          "in_bytes": "bytes",
          "out_bytes": "bytes",
          "bytes": "bytes",
          "in_pkts": "packets",
          "out_pkts": "packets",
          "pkts": "packets",
          "new_c2s_flows": "flows",
          "new_s2c_flows": "flows",
          "new_in_sessions": "sessions",
          "new_out_sessions": "sessions",
          "sessions": "sessions",
          "new_unestablished_sessions": "sessions",
          "syn_pkts": "packets",
          "c2s_ip_fragments": "packets",
          "s2c_ip_fragments": "packets",
          "ip_fragments": "packets"
        },
        "RATE": {
          "in_bytes": "Bps",
          "out_bytes": "Bps",
          "bytes": "Bps",
          "in_pkts": "pps",
          "out_pkts": "pps",
          "pkts": "pps",
          "new_c2s_flows": "fps",
          "new_s2c_flows": "fps",
          "new_in_sessions": "sps",
          "new_out_sessions": "sps",
          "sessions": "sps",
          "new_unestablished_sessions": "sps",
          "syn_pkts": "pps",
          "c2s_ip_fragments": "pps",
          "s2c_ip_fragments": "pps",
          "ip_fragments": "pps"
        },
        "BITRATE": {
          "in_bytes": "bps",
          "out_bytes": "bps",
          "bytes": "bps"
        },
        "APPROX_COUNT_DISTINCT_HLLD": {
          "session_identifier_sketch": "sessions",
          "client_ip_sketch": "short",
          "server_ip_sketch": "short"
        },
        "MEDIAN_HDR": {
          "in_latency_ms_sketch": "ms",
          "out_latency_ms_sketch": "ms",
          "latency_ms_sketch": "ms",
          "in_pkt_length_sketch": "packets",
          "out_pkt_length_sketch": "packets",
          "pkt_length_sketch": "packets"
        },
        "P95_PERCENTILE_HDR": {
          "in_latency_ms_sketch": "ms",
          "out_latency_ms_sketch": "ms",
          "latency_ms_sketch": "ms",
          "in_pkt_length_sketch": "packets",
          "out_pkt_length_sketch": "packets",
          "pkt_length_sketch": "packets"
        },
        "P99_PERCENTILE_HDR": {
          "in_latency_ms_sketch": "ms",
          "out_latency_ms_sketch": "ms",
          "latency_ms_sketch": "ms",
          "in_pkt_length_sketch": "packets",
          "out_pkt_length_sketch": "packets",
          "pkt_length_sketch": "packets"
        },
        "PERCENTILES_HDR": {
          "in_latency_ms_sketch": "ms",
          "out_latency_ms_sketch": "ms",
          "latency_ms_sketch": "ms",
          "in_pkt_length_sketch": "packets",
          "out_pkt_length_sketch": "packets",
          "pkt_length_sketch": "packets"
        }
      }
    }
  },
  "fields": [
    {
      "name": "__time",
      "label": "Time",
      "type": {
        "type": "string",
        "logicalType": "timestamp"
      },
      "doc": {
        "constraints": {
          "type": "timestamp"
        },
        "visibility": "enabled"
      }
    },
    {
      "name": "vsys_id",
      "label": "Vsys ID",
      "doc": {
        "visibility": "enabled"
      },
      "type": "long",
      "default": 1
    },
    {
      "name": "device_id",
      "label": "Device ID",
      "doc": {
        "visibility": "enabled"
      },
      "type": "string"
    },
    {
      "name": "device_group",
      "label": "Device Group",
      "type": "string",
      "doc": {
        "constraints": {
          "operator_functions": "=,in"
        },
        "data": {
          "$ref": "device_tag.json#",
          "key": "$[?(@.tagType=='device_group')].subTags.[?(@.tagType=='device_group')]['tagValue']",
          "value": "$[?(@.tagType=='device_group')].subTags.[?(@.tagType=='device_group')]['tagName']"
        },
        "visibility": "enabled"
      }
    },
    {
      "name": "data_center",
