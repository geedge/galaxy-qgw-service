          "operator_functions": "=,in"
        },
        "data": {
          "$ref": "device_tag.json#",
          "key": "$[?(@.tagType=='data_center')].subTags.[?(@.tagType=='data_center')]['tagValue']",
          "value": "$[?(@.tagType=='data_center')].subTags.[?(@.tagType=='data_center')]['tagName']"
        },
        "visibility": "enabled"
      }
    },
    {
      "name": "rule_id",
      "label": "Rule",
      "doc": {
