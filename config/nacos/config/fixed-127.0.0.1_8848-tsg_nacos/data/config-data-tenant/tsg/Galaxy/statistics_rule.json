{
  "type": "record",
  "name": "statistics_rule",
  "namespace": "druid",
  "doc": {
    "partition_key": "__time",
    "functions": {
      "$ref": "public_schema_info.json#/functions"
    },
    "schema_query": {
      "dimensions": [
        "vsys_id",
        "device_id",
        "device_group",
        "data_center",
        "rule_id",
        "template_id",
        "chart_id",
