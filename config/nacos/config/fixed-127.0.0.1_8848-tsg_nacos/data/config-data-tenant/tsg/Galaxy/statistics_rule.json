        "vsys_id",
        "device_id",
        "device_group",
        "data_center",
        "rule_id",
        "template_id",
        "chart_id",
        "version",
        "client_ip_object",
        "server_ip_object",
        "fqdn_category",
        "client_ip",
        "server_ip",
        "server_fqdn",
        "server_domain",
        "application",
        "in_bytes",
        "out_bytes",
