        "visibility": "enabled"
      },
      "type": "long"
    },
    {
      "name": "s2c_fragments",
      "label": "Fragmentation Packets(s2c)",
      "doc": {
        "constraints": {
          "metric_type": "count",
          "aggregation_functions": "SUM, RATE"
