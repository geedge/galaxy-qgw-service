{
  "namespace": "avtest",
  "type": "record",
  "name": "frag_index_event_log",
  "fields": [
    {
      "name": "log_id",
      "type": "long",
      "doc": "{\"format\":{\"functions\":\"snowflake_id\"}}"
    },
    {
      "name": "recv_time",
      "type": "int",
      "doc": "{\"format\":{\"functions\":\"current_timestamp\"}}"
    },
    {
      "name": "client_ip",
      "type": "string"
    },
    {
      "name": "server_ip",
      "type": "string"
    },
    {
      "name": "client_port",
      "type": "int"
    },
    {
      "name": "server_port",
      "type": "int"
    },
    {
      "name": "addr_type",
      "type": "int"
    },
    {
      "name": "cap_ip",
      "type": "string"
    },
    {
      "name": "nirvana_ip",
      "type": "string"
    },
    {
      "name": "found_time",
      "type": "long"
    },
    {
      "name": "media_url",
      "type": "string"
    },
    {
      "name": "media_ua",
      "type": "string"
    },
    {
      "name": "media_referer",
      "type": "string"
    },
    {
      "name": "media_key",
      "type": "string"
    },
    {
      "name": "frag_counts",
      "type": "int"
    }
  ]
}