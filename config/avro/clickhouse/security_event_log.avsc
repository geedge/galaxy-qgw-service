  "fields": [
    {
      "name": "common_recv_time",
      "type": "int",
      "label": "Receive Time",
      "doc": "{\"allow_query\":\"true\",\"constraints\":{\"type\":\"timestamp\"},\"format\":{\"functions\":\"current_timestamp\"}}}"
    },
    {
      "name": "common_log_id",
      "type": "long",
      "label": "Log ID",
      "doc": "{\"allow_query\":\"true\",\"format\":{\"functions\":\"snowflake_id\"}}"
    },
    {
      "name": "common_policy_id",
      "type": "int",
      "label": "Policy ID",
      "doc": "{\"allow_query\":\"true\"}"
    },
    {
