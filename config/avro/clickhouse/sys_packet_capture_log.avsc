      "type": "int",
      "label": "Address Type",
      "doc": "{\"data\":[{\"code\":\"4\",\"value\":\"ipv4\"},{\"code\":\"6\",\"value\":\"ipv6\"}]}"
    },
    {
      "name": "common_server_ip",
      "type": "string",
      "label": "Server IP",
