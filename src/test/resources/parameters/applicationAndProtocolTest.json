{
  "application_and_protocol_summary": {
    "name": "application-and-protocol-summary",
    "granularity": "PT5S",
    "filter": "vsys_id = 1",
    "intervals": [
      "2024-01-30 00:00:00/2024-01-31 00:00:00"
    ]
  },
  "application_and_protocol_tree_composition": {
    "name": "application-and-protocol-tree-composition",
    "filter": "vsys_id = 1",
    "intervals": [
