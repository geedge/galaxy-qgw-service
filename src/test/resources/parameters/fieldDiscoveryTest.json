{
  "field_discovery_default": {
    "name": "field-discovery",
    "data_source": "session_record",
    "fields": [
      "client_ip",
      "server_port"
    ],
    "filter": "vsys_id in (1) AND ( 1 = 1 )"
  },
  "field_discovery_sessions": {
    "name": "field-discovery",
    "data_source": "session_record",
    "fields": [
      "client_ip",
      "server_port"
    ],
    "filter": "vsys_id in (1) AND ( 1 = 1 )",
    "custom.statistics.metrics": [
      {
        "function": {
          "name": "count"
        },
        "metric_name": "sessions"
      }
    ]
  },
  "field_discovery_bytes": {
    "name": "field-discovery",
    "data_source": "session_record",
    "fields": [
      "client_ip",
      "server_port"
    ],
    "filter": "vsys_id in (1) AND ( 1 = 1 )",
    "custom.statistics.metrics": [
      {
        "function": {
          "name": "sum"
        },
        "metric_name": "bytes"
      }
    ]
  },
  "field_discovery_incoming_bytes": {
    "name": "field-discovery",
    "data_source": "session_record",
    "fields": [
      "client_ip",
      "server_port"
    ],
    "filter": "vsys_id in (1) AND ( 1 = 1 )",
    "custom.statistics.metrics": [
      {
        "function": {
          "name": "sum"
        },
        "metric_name": "incoming_bytes"
      }
    ]
  },
  "field_discovery_outgoing_bytes": {
    "name": "field-discovery",
    "data_source": "session_record",
    "fields": [
      "client_ip",
      "server_port"
    ],
    "filter": "vsys_id in (1) AND ( 1 = 1 )",
    "custom.statistics.metrics": [
      {
        "function": {
          "name": "sum"
        },
        "metric_name": "outgoing_bytes"
      }
    ]
  }
}