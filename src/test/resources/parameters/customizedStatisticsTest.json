{
  "metrics_value_statistics": {
    "name": "customized-statistics",
    "data_source": "statistics_rule",
    "filter": "vsys_id in (1) AND rule_uuid = '1' AND template_uuid = '1' AND chart_uuid = '1' AND version = 1",
    "custom.statistics.dimensions": [
      {
        "dimension_name": "destination_fqdn",
        "label": "Destination FQDN"
      }
    ],
    "custom.statistics.metrics": [
      {
        "function": {
          "name": "UNIQUE_COUNT"
        },
        "metric_name": "unique_count_1",
        "metric_type": "unique_count",
        "label": "Clients"
      },
      {
        "function": {
          "name": "BITRATE"
        },
        "metric_name": "count_1",
        "metric_type": "count",
        "label": "Throughput"
      },
      {
        "function": {
          "name": "COUNT"
        },
        "metric_name": "destination_ip",
        "label": "Sessions"
      }
    ],
    "intervals": [
      "2024-07-01 00:00:00/2024-07-02 00:00:00"
    ],
    "order_by": "Clients DESC",
    "limit": 10,
    "execution_mode": "oneshot"
  },
  "metrics_value_statistics_over_time": {
    "name": "customized-statistics",
    "data_source": "statistics_rule",
    "filter": "vsys_id in (1) AND rule_uuid = '1' AND template_uuid = '1' AND chart_uuid = '1' AND version = 1",
    "custom.statistics.dimensions": [
      {
        "function": {
          "name": "DATETIME_FLOOR_WITH_FILL"
        },
        "dimension_name": "__time",
        "label": "Stat Time"
      }
    ],
    "custom.statistics.metrics": [
      {
        "function": {
          "name": "UNIQUE_COUNT"
        },
        "metric_name": "source_ip",
        "label": "Source IPs"
      },
      {
        "function": {
          "name": "SUM"
        },
        "metric_name": "count_1",
        "metric_type": "count",
        "label": "Bytes"
      }
    ],
    "intervals": [
      "2020-01-01 00:00:00/2020-01-02 00:00:00"
    ],
    "execution_mode": "oneshot"
  },
  "metrics_value_series_statistics_over_time": {
    "name": "customized-statistics",
    "data_source": "statistics_rule",
    "filter": "vsys_id in (1) AND rule_uuid = '1' AND template_uuid = '1' AND chart_uuid = '1' AND version = 1",
    "custom.statistics.dimensions": [
      {
        "function": {
          "name": "DATETIME_FLOOR_WITH_FILL"
        },
        "dimension_name": "__time",
        "label": "Stat Time"
      },
      {
        "dimension_name": "source_ip",
        "label": "Source IP"
      }
    ],
    "custom.statistics.metrics": [
      {
        "function": {
          "name": "SUM"
        },
        "metric_name": "count_1",
        "metric_type": "count",
        "label": "Bytes"
      }
    ],
    "custom.statistics.subquery.topk": {
      "dimensions": [
        "Source IP"
      ],
      "metric": "Bytes",
      "limit": 10
    },
    "intervals": [
      "2020-01-01 00:00:00/2020-01-02 00:00:00"
    ],
    "execution_mode": "oneshot"
  }
}